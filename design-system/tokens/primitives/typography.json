{
  "font": {
    "family": {
      "$type": "fontFamily",
      "display": {
        "$value": ["Schibsted Grotesk", "Helvetica Neue", "Arial", "sans-serif"],
        "$description": "Titres et grands chiffres. Grotesque dense, serrée en approche : le poids du béton."
      },
      "text": {
        "$value": ["Instrument Sans", "system-ui", "-apple-system", "Segoe UI", "Roboto", "sans-serif"],
        "$description": "Texte courant, formulaires, listes. Chiffres tabulaires disponibles."
      },
      "mono": {
        "$value": ["IBM Plex Mono", "ui-monospace", "SF Mono", "Menlo", "monospace"],
        "$description": "Langage du plan : clés de cartouche, cotes, références, codes métier."
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 },
      "extrabold": { "$value": 800 },
      "black": { "$value": 900 }
    },
    "size": {
      "$type": "dimension",
      "$description": "Échelle typographique en rem (1rem = 16px).",
      "xs": { "$value": "0.75rem" },
      "sm": { "$value": "0.875rem" },
      "md": { "$value": "1rem" },
      "lg": { "$value": "1.125rem" },
      "xl": { "$value": "1.25rem" },
      "2xl": { "$value": "1.5rem" },
      "3xl": { "$value": "2rem" },
      "4xl": { "$value": "2.5rem" },
      "5xl": { "$value": "3.5rem" }
    },
    "line-height": {
      "$type": "number",
      "compact": { "$value": 0.9, "$description": "Grands chiffres." },
      "tight": { "$value": 1.08, "$description": "Titres." },
      "snug": { "$value": 1.3, "$description": "Libellés, titres de carte." },
      "normal": { "$value": 1.5, "$description": "Texte courant." }
    },
    "letter-spacing": {
      "$type": "dimension",
      "tighter": { "$value": "-0.045em", "$description": "Grands chiffres." },
      "tight": { "$value": "-0.025em", "$description": "Titres en Schibsted." },
      "normal": { "$value": "0em" },
      "wide": { "$value": "0.04em", "$description": "Libellés de boutons en capitales." },
      "wider": { "$value": "0.1em", "$description": "Clés de cartouche et sur-titres en mono capitales." }
    }
  }
}
