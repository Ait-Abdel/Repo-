{
  "color": {
    "$type": "color",
    "bg": {
      "$description": "Fonds.",
      "canvas": { "$value": "{palette.beton.975}", "$description": "Fond de page, derrière les cartes." },
      "surface": { "$value": "{palette.beton.950}", "$description": "Cartes, panneaux, tableaux, barres de navigation." },
      "raised": { "$value": "{palette.beton.900}", "$description": "Menus, popovers, modales, bottom sheets (avec une ombre)." },
      "sunken": { "$value": "{palette.beton.975}", "$description": "Zones en creux : champs en lecture seule, pistes de progression, en-têtes de tableau." },
      "hover": { "$value": "{palette.beton.900}", "$description": "Survol de lignes et d'éléments neutres." },
      "selected": { "$value": "{palette.bleu.950}", "$description": "Ligne ou élément sélectionné." },
      "inverse": { "$value": "{palette.beton.100}", "$description": "Toasts, infobulles." },
      "overlay": { "$value": "#000000b3", "$description": "Voile derrière une modale ou une bottom sheet." }
    },
    "fg": {
      "$description": "Textes et icônes.",
      "default": { "$value": "{palette.beton.100}", "$description": "Texte principal, sur tous les fonds bg.*." },
      "muted": { "$value": "{palette.beton.400}", "$description": "Texte secondaire : métadonnées, aides de champ, dates. Sur bg.canvas, surface, raised, sunken." },
      "subtle": { "$value": "{palette.beton.500}", "$description": "Icônes décoratives, placeholders. 3:1 minimum : jamais pour un texte indispensable." },
      "disabled": { "$value": "{palette.beton.600}", "$description": "Texte et icônes désactivés (pas d'exigence de contraste, mais toujours doublé d'un état non coloré)." },
      "inverse": { "$value": "{palette.beton.900}", "$description": "Texte sur bg.inverse." },
      "link": { "$value": "{color.primary.text}", "$description": "Liens dans le texte." }
    },
    "border": {
      "$description": "Contours et séparateurs.",
      "subtle": { "$value": "{palette.beton.800}", "$description": "Séparateurs de lignes, contours de cartes." },
      "default": { "$value": "{palette.beton.700}", "$description": "Contours de boutons secondaires, puces." },
      "strong": { "$value": "{palette.beton.500}", "$description": "Contours de champs de saisie et cases à cocher (3:1 minimum)." },
      "focus": { "$value": "{palette.bleu.400}", "$description": "Anneau de focus clavier, sur tous les fonds." }
    },
    "primary": {
      "$description": "Bleu de travail : action principale, éléments actifs, liens.",
      "solid": { "$value": "{palette.bleu.400}" },
      "solid-hover": { "$value": "{palette.bleu.300}" },
      "solid-active": { "$value": "{palette.bleu.200}" },
      "on-solid": { "$value": "{palette.beton.975}" },
      "subtle": { "$value": "{palette.bleu.950}" },
      "on-subtle": { "$value": "{palette.bleu.200}" },
      "text": { "$value": "{palette.bleu.300}" }
    },
    "accent": {
      "$description": "Orange signalisation : un seul élément mis en avant par écran (bouton « Nouveau chantier », nouveauté). Texte foncé dessus, dans les deux thèmes.",
      "solid": { "$value": "{palette.orange.400}" },
      "solid-hover": { "$value": "{palette.orange.300}" },
      "on-solid": { "$value": "{palette.beton.975}" },
      "subtle": { "$value": "{palette.orange.950}" },
      "on-subtle": { "$value": "{palette.orange.200}" },
      "text": { "$value": "{palette.orange.400}" }
    },
    "success": {
      "$description": "Réussite, terminé, conforme.",
      "solid": { "$value": "{palette.vert.400}" },
      "on-solid": { "$value": "{palette.beton.975}" },
      "subtle": { "$value": "{palette.vert.950}" },
      "on-subtle": { "$value": "{palette.vert.200}" },
      "border": { "$value": "{palette.vert.500}" },
      "text": { "$value": "{palette.vert.400}" }
    },
    "warning": {
      "$description": "Attention, en attente, à vérifier. Toujours du texte foncé sur le fond plein.",
      "solid": { "$value": "{palette.ambre.400}" },
      "on-solid": { "$value": "{palette.beton.975}" },
      "subtle": { "$value": "{palette.ambre.950}" },
      "on-subtle": { "$value": "{palette.ambre.200}" },
      "border": { "$value": "{palette.ambre.500}" },
      "text": { "$value": "{palette.ambre.300}" }
    },
    "danger": {
      "$description": "Erreur, retard, suppression, risque.",
      "solid": { "$value": "{palette.rouge.500}" },
      "on-solid": { "$value": "{palette.beton.975}" },
      "subtle": { "$value": "{palette.rouge.950}" },
      "on-subtle": { "$value": "{palette.rouge.200}" },
      "border": { "$value": "{palette.rouge.500}" },
      "text": { "$value": "{palette.rouge.300}" }
    },
    "info": {
      "$description": "Information neutre, en cours.",
      "solid": { "$value": "{palette.bleu.500}" },
      "on-solid": { "$value": "{palette.beton.975}" },
      "subtle": { "$value": "{palette.bleu.950}" },
      "on-subtle": { "$value": "{palette.bleu.200}" },
      "border": { "$value": "{palette.bleu.500}" },
      "text": { "$value": "{palette.bleu.300}" }
    },
    "statut": {
      "$description": "Statuts d'un chantier, d'une tâche ou d'une réserve. Toujours accompagnés d'un libellé et d'une icône.",
      "planifie": {
        "$description": "Planifié, pas encore démarré.",
        "solid": { "$value": "{palette.beton.400}" },
        "subtle": { "$value": "{palette.beton.900}" },
        "on-subtle": { "$value": "{palette.beton.200}" }
      },
      "en-cours": {
        "$description": "En cours.",
        "solid": { "$value": "{color.info.solid}" },
        "subtle": { "$value": "{color.info.subtle}" },
        "on-subtle": { "$value": "{color.info.on-subtle}" }
      },
      "en-attente": {
        "$description": "En attente, bloqué (matériel, validation, météo).",
        "solid": { "$value": "{color.warning.solid}" },
        "subtle": { "$value": "{color.warning.subtle}" },
        "on-subtle": { "$value": "{color.warning.on-subtle}" }
      },
      "en-retard": {
        "$description": "En retard sur le planning.",
        "solid": { "$value": "{color.danger.solid}" },
        "subtle": { "$value": "{color.danger.subtle}" },
        "on-subtle": { "$value": "{color.danger.on-subtle}" }
      },
      "termine": {
        "$description": "Terminé, réceptionné, réserve levée.",
        "solid": { "$value": "{color.success.solid}" },
        "subtle": { "$value": "{color.success.subtle}" },
        "on-subtle": { "$value": "{color.success.on-subtle}" }
      }
    },
    "metier": {
      "$description": "Familles de corps d'état. La couleur identifie la famille, l'icône et le code identifient le métier. solid : barres de planning, pastilles ; subtle + on-subtle : badges.",
      "gros-oeuvre": {
        "$description": "Terrassement, VRD, démolition, fondations, maçonnerie, béton.",
        "solid": { "$value": "{palette.brique.500}" },
        "subtle": { "$value": "{palette.brique.900}" },
        "on-subtle": { "$value": "{palette.brique.200}" }
      },
      "structure": {
        "$description": "Charpente bois et métal, ossature bois, serrurerie-métallerie.",
        "solid": { "$value": "{palette.bois.300}" },
        "subtle": { "$value": "{palette.bois.900}" },
        "on-subtle": { "$value": "{palette.bois.200}" }
      },
      "electricite": {
        "$description": "Électricité courants forts et faibles, domotique, photovoltaïque.",
        "solid": { "$value": "{palette.jaune.400}" },
        "subtle": { "$value": "{palette.jaune.900}" },
        "on-subtle": { "$value": "{palette.jaune.200}" }
      },
      "exterieurs": {
        "$description": "Aménagements extérieurs, espaces verts, clôtures, piscines.",
        "solid": { "$value": "{palette.feuille.400}" },
        "subtle": { "$value": "{palette.feuille.900}" },
        "on-subtle": { "$value": "{palette.feuille.200}" }
      },
      "fluides": {
        "$description": "Plomberie, sanitaire, chauffage, ventilation, climatisation.",
        "solid": { "$value": "{palette.eau.500}" },
        "subtle": { "$value": "{palette.eau.900}" },
        "on-subtle": { "$value": "{palette.eau.200}" }
      },
      "enveloppe": {
        "$description": "Couverture, zinguerie, étanchéité, façade, menuiseries extérieures.",
        "solid": { "$value": "{palette.ardoise.300}" },
        "subtle": { "$value": "{palette.ardoise.900}" },
        "on-subtle": { "$value": "{palette.ardoise.200}" }
      },
      "amenagement": {
        "$description": "Plâtrerie, cloisons, isolation, faux plafonds, menuiseries intérieures.",
        "solid": { "$value": "{palette.lavande.400}" },
        "subtle": { "$value": "{palette.lavande.900}" },
        "on-subtle": { "$value": "{palette.lavande.200}" }
      },
      "finitions": {
        "$description": "Peinture, carrelage, revêtements de sol, faïence.",
        "solid": { "$value": "{palette.framboise.500}" },
        "subtle": { "$value": "{palette.framboise.900}" },
        "on-subtle": { "$value": "{palette.framboise.200}" }
      },
      "autre": {
        "$description": "Métier non classé, sous-traitant divers.",
        "solid": { "$value": "{palette.beton.500}" },
        "subtle": { "$value": "{palette.beton.900}" },
        "on-subtle": { "$value": "{palette.beton.200}" }
      }
    }
  },
  "shadow": {
    "$type": "shadow",
    "sm": { "$value": {"color": "#00000066", "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px"}, "$description": "Cartes au repos (optionnel : préférer le contour border.subtle)." },
    "md": { "$value": {"color": "#00000080", "offsetX": "0px", "offsetY": "4px", "blur": "12px", "spread": "0px"}, "$description": "Menus déroulants, popovers, carte en cours de glisser." },
    "lg": { "$value": {"color": "#000000a6", "offsetX": "0px", "offsetY": "16px", "blur": "40px", "spread": "-4px"}, "$description": "Modales, bottom sheets, toasts." }
  }
}
