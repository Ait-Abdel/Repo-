{
  "color": {
    "$type": "color",
    "bg": {
      "$description": "Fonds.",
      "canvas": { "$value": "{palette.beton.50}", "$description": "Fond de page, derrière les cartes." },
      "surface": { "$value": "{palette.blanc}", "$description": "Cartes, panneaux, tableaux, barres de navigation." },
      "raised": { "$value": "{palette.blanc}", "$description": "Menus, popovers, modales, bottom sheets (avec une ombre)." },
      "sunken": { "$value": "{palette.beton.100}", "$description": "Zones en creux : champs en lecture seule, pistes de progression, en-têtes de tableau." },
      "hover": { "$value": "{palette.beton.100}", "$description": "Survol de lignes et d'éléments neutres." },
      "selected": { "$value": "{palette.bleu.50}", "$description": "Ligne ou élément sélectionné." },
      "inverse": { "$value": "{palette.beton.900}", "$description": "Toasts, infobulles." },
      "overlay": { "$value": "#15141199", "$description": "Voile derrière une modale ou une bottom sheet." }
    },
    "fg": {
      "$description": "Textes et icônes.",
      "default": { "$value": "{palette.beton.900}", "$description": "Texte principal, sur tous les fonds bg.*." },
      "muted": { "$value": "{palette.beton.600}", "$description": "Texte secondaire : métadonnées, aides de champ, dates. Sur bg.canvas, surface, raised, sunken." },
      "subtle": { "$value": "{palette.beton.500}", "$description": "Icônes décoratives, placeholders. 3:1 minimum : jamais pour un texte indispensable." },
      "disabled": { "$value": "{palette.beton.400}", "$description": "Texte et icônes désactivés (pas d'exigence de contraste, mais toujours doublé d'un état non coloré)." },
      "inverse": { "$value": "{palette.blanc}", "$description": "Texte sur bg.inverse." },
      "link": { "$value": "{color.primary.text}", "$description": "Liens dans le texte." }
    },
    "border": {
      "$description": "Contours et séparateurs.",
      "subtle": { "$value": "{palette.beton.200}", "$description": "Séparateurs de lignes, contours de cartes." },
      "default": { "$value": "{palette.beton.300}", "$description": "Contours de boutons secondaires, puces." },
      "strong": { "$value": "{palette.beton.500}", "$description": "Contours de champs de saisie et cases à cocher (3:1 minimum)." },
      "focus": { "$value": "{palette.bleu.600}", "$description": "Anneau de focus clavier, sur tous les fonds." }
    },
    "primary": {
      "$description": "Bleu de travail : action principale, éléments actifs, liens.",
      "solid": { "$value": "{palette.bleu.700}" },
      "solid-hover": { "$value": "{palette.bleu.800}" },
      "solid-active": { "$value": "{palette.bleu.900}" },
      "on-solid": { "$value": "{palette.blanc}" },
      "subtle": { "$value": "{palette.bleu.50}" },
      "on-subtle": { "$value": "{palette.bleu.800}" },
      "text": { "$value": "{palette.bleu.700}" }
    },
    "accent": {
      "$description": "Orange signalisation : un seul élément mis en avant par écran (bouton « Nouveau chantier », nouveauté). Texte foncé dessus, dans les deux thèmes.",
      "solid": { "$value": "{palette.orange.500}" },
      "solid-hover": { "$value": "{palette.orange.400}" },
      "on-solid": { "$value": "{palette.beton.975}" },
      "subtle": { "$value": "{palette.orange.50}" },
      "on-subtle": { "$value": "{palette.orange.800}" },
      "text": { "$value": "{palette.orange.700}" }
    },
    "success": {
      "$description": "Réussite, terminé, conforme.",
      "solid": { "$value": "{palette.vert.700}" },
      "on-solid": { "$value": "{palette.blanc}" },
      "subtle": { "$value": "{palette.vert.50}" },
      "on-subtle": { "$value": "{palette.vert.800}" },
      "border": { "$value": "{palette.vert.600}" },
      "text": { "$value": "{palette.vert.700}" }
    },
    "warning": {
      "$description": "Attention, en attente, à vérifier. Toujours du texte foncé sur le fond plein.",
      "solid": { "$value": "{palette.ambre.500}" },
      "on-solid": { "$value": "{palette.beton.975}" },
      "subtle": { "$value": "{palette.ambre.50}" },
      "on-subtle": { "$value": "{palette.ambre.800}" },
      "border": { "$value": "{palette.ambre.500}" },
      "text": { "$value": "{palette.ambre.700}" }
    },
    "danger": {
      "$description": "Erreur, retard, suppression, risque.",
      "solid": { "$value": "{palette.rouge.700}" },
      "on-solid": { "$value": "{palette.blanc}" },
      "subtle": { "$value": "{palette.rouge.50}" },
      "on-subtle": { "$value": "{palette.rouge.800}" },
      "border": { "$value": "{palette.rouge.600}" },
      "text": { "$value": "{palette.rouge.700}" }
    },
    "info": {
      "$description": "Information neutre, en cours.",
      "solid": { "$value": "{palette.bleu.600}" },
      "on-solid": { "$value": "{palette.blanc}" },
      "subtle": { "$value": "{palette.bleu.50}" },
      "on-subtle": { "$value": "{palette.bleu.800}" },
      "border": { "$value": "{palette.bleu.500}" },
      "text": { "$value": "{palette.bleu.700}" }
    },
    "statut": {
      "$description": "Statuts d'un chantier, d'une tâche ou d'une réserve. Toujours accompagnés d'un libellé et d'une icône.",
      "planifie": {
        "$description": "Planifié, pas encore démarré.",
        "solid": { "$value": "{palette.beton.500}" },
        "subtle": { "$value": "{palette.beton.100}" },
        "on-subtle": { "$value": "{palette.beton.800}" }
      },
      "en-cours": {
        "$description": "En cours.",
        "solid": { "$value": "{color.info.solid}" },
        "subtle": { "$value": "{color.info.subtle}" },
        "on-subtle": { "$value": "{color.info.on-subtle}" }
      },
      "en-attente": {
        "$description": "En attente, bloqué (matériel, validation, météo).",
        "solid": { "$value": "{color.warning.solid}" },
        "subtle": { "$value": "{color.warning.subtle}" },
        "on-subtle": { "$value": "{color.warning.on-subtle}" }
      },
      "en-retard": {
        "$description": "En retard sur le planning.",
        "solid": { "$value": "{color.danger.solid}" },
        "subtle": { "$value": "{color.danger.subtle}" },
        "on-subtle": { "$value": "{color.danger.on-subtle}" }
      },
      "termine": {
        "$description": "Terminé, réceptionné, réserve levée.",
        "solid": { "$value": "{color.success.solid}" },
        "subtle": { "$value": "{color.success.subtle}" },
        "on-subtle": { "$value": "{color.success.on-subtle}" }
      }
    },
    "metier": {
      "$description": "Familles de corps d'état. La couleur identifie la famille, l'icône et le code identifient le métier. solid : barres de planning, pastilles ; subtle + on-subtle : badges.",
      "gros-oeuvre": {
        "$description": "Terrassement, VRD, démolition, fondations, maçonnerie, béton.",
        "solid": { "$value": "{palette.brique.700}" },
        "subtle": { "$value": "{palette.brique.100}" },
        "on-subtle": { "$value": "{palette.brique.800}" }
      },
      "structure": {
        "$description": "Charpente bois et métal, ossature bois, serrurerie-métallerie.",
        "solid": { "$value": "{palette.bois.600}" },
        "subtle": { "$value": "{palette.bois.100}" },
        "on-subtle": { "$value": "{palette.bois.800}" }
      },
      "electricite": {
        "$description": "Électricité courants forts et faibles, domotique, photovoltaïque.",
        "solid": { "$value": "{palette.jaune.500}" },
        "subtle": { "$value": "{palette.jaune.100}" },
        "on-subtle": { "$value": "{palette.jaune.800}" }
      },
      "exterieurs": {
        "$description": "Aménagements extérieurs, espaces verts, clôtures, piscines.",
        "solid": { "$value": "{palette.feuille.600}" },
        "subtle": { "$value": "{palette.feuille.100}" },
        "on-subtle": { "$value": "{palette.feuille.800}" }
      },
      "fluides": {
        "$description": "Plomberie, sanitaire, chauffage, ventilation, climatisation.",
        "solid": { "$value": "{palette.eau.500}" },
        "subtle": { "$value": "{palette.eau.100}" },
        "on-subtle": { "$value": "{palette.eau.800}" }
      },
      "enveloppe": {
        "$description": "Couverture, zinguerie, étanchéité, façade, menuiseries extérieures.",
        "solid": { "$value": "{palette.ardoise.700}" },
        "subtle": { "$value": "{palette.ardoise.100}" },
        "on-subtle": { "$value": "{palette.ardoise.800}" }
      },
      "amenagement": {
        "$description": "Plâtrerie, cloisons, isolation, faux plafonds, menuiseries intérieures.",
        "solid": { "$value": "{palette.lavande.600}" },
        "subtle": { "$value": "{palette.lavande.100}" },
        "on-subtle": { "$value": "{palette.lavande.800}" }
      },
      "finitions": {
        "$description": "Peinture, carrelage, revêtements de sol, faïence.",
        "solid": { "$value": "{palette.framboise.500}" },
        "subtle": { "$value": "{palette.framboise.100}" },
        "on-subtle": { "$value": "{palette.framboise.800}" }
      },
      "autre": {
        "$description": "Métier non classé, sous-traitant divers.",
        "solid": { "$value": "{palette.beton.600}" },
        "subtle": { "$value": "{palette.beton.100}" },
        "on-subtle": { "$value": "{palette.beton.800}" }
      }
    }
  },
  "shadow": {
    "$type": "shadow",
    "sm": { "$value": [{"color": "#15141114", "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px"},{"color": "#1514110f", "offsetX": "0px", "offsetY": "1px", "blur": "3px", "spread": "0px"}], "$description": "Cartes au repos (optionnel : préférer le contour border.subtle)." },
    "md": { "$value": [{"color": "#15141114", "offsetX": "0px", "offsetY": "2px", "blur": "4px", "spread": "0px"},{"color": "#1514111f", "offsetX": "0px", "offsetY": "6px", "blur": "16px", "spread": "-2px"}], "$description": "Menus déroulants, popovers, carte en cours de glisser." },
    "lg": { "$value": [{"color": "#1514111a", "offsetX": "0px", "offsetY": "8px", "blur": "16px", "spread": "0px"},{"color": "#15141129", "offsetX": "0px", "offsetY": "20px", "blur": "40px", "spread": "-8px"}], "$description": "Modales, bottom sheets, toasts." }
  }
}
